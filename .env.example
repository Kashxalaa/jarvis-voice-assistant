GEMINI_API_KEY=your_free_gemini_api_key_here
# Optional: override the default model fallback chain (comma-separated,
# tried in order — each Gemini model has its own separate free-tier
# daily quota, so this list is tried top to bottom as each is exhausted)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_private_channel_id_here
DISCORD_OWNER_ID=your_discord_user_id_here

# Optional: path to a Chromium-based browser executable (Brave, Edge,
# Chrome) used to force PC-automation URL actions to open in a new
# window instead of a tab. If unset, Jarvis auto-detects Brave at its
# standard Windows install location; if that also fails, it falls back
# to opening a tab in your default browser instead.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Postgres connection string. All surfaces (CLI, local Discord bot,
# cloud Discord bot) connect to the same database, self-hosted on the
# Oracle Cloud VM. Local development: point this at your local Postgres
# instance instead (e.g. postgresql://postgres:postgres@localhost:5432/jarvis).
DATABASE_URL=postgresql://user:password@host:5432/jarvis

# "local" (default) or "cloud". The cloud deployment sets this to
# "cloud" so it knows to defer to the local instance whenever it's
# reachable, instead of always answering.
# JARVIS_ROLE=cloud

# Optional: only needed to run the test suite if your local Postgres
# superuser password differs from the tests/conftest.py fallback
# ("postgres"). Points at a throwaway local database — the test suite
# TRUNCATEs it before every test.
# TEST_DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/jarvis_test

# Optional: only needed to run the notes/semantic-memory test suite.
# Points at a Postgres database with the pgvector extension enabled —
# on this project, that's a database on the same Oracle VM the cloud
# instance uses (pgvector isn't available for local Windows Postgres).
# NOTES_TEST_DATABASE_URL=postgresql://postgres:your_password@your-vm-ip:5432/jarvis_test

# Optional: enables the web_search tool (Exa). Get a free-tier key at
# https://exa.ai — if unset, web_search is simply not offered to Jarvis
# rather than failing when asked to search.
# EXA_API_KEY=your_exa_api_key_here

# Optional: the timezone Jarvis uses for "today" and the current time
# (IANA name). Defaults to Asia/Tbilisi.
# JARVIS_TIMEZONE=Asia/Tbilisi

# Optional: the latest local time (HH:MM, in JARVIS_TIMEZONE) at which
# Jarvis posts and pins the daily to-do list on Discord. Defaults to
# 09:00. It may post earlier than this — see TODO_LIST_LEAD_MINUTES.
# TODO_LIST_TIME=09:00

# Optional: local time (HH:MM, in JARVIS_TIMEZONE) of the evening "still on
# your list" nudge for undone untimed reminders and to-dos. Defaults to 19:30.
# NUDGE_TIME=19:30

# Optional: how many minutes before the day's first timed reminder the
# daily to-do list posts, if that's earlier than TODO_LIST_TIME. Defaults
# to 30.
# TODO_LIST_LEAD_MINUTES=30

# Optional: free Groq key (console.groq.com) — the judge that routes each
# message to Groq (small talk), Gemini (normal) or Claude (hard).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Claude via your Claude Pro/Max subscription. Create with
# `claude setup-token` (valid one year). Leave ANTHROPIC_API_KEY unset.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...
# CLAUDE_MODEL=sonnet
# Optional: full path to the native claude executable. Auto-detected on Windows
# (the npm claude.CMD shim doesn't work with the SDK); rarely needed elsewhere.
# CLAUDE_CLI_PATH=

# Optional: show which brain answered at the end of each reply (default true).
# JARVIS_SHOW_BRAIN=true

# Optional: Claude computer access. /bypass lasts this many hours (default 12);
# a computer task stops after this many steps / minutes (defaults 60 / 30).
# BYPASS_HOURS=12
# COMPUTER_TASK_MAX_STEPS=60
# COMPUTER_TASK_TIMEOUT_MINUTES=30
